// JNI方法实现
JNIEXPORT void JNICALL
Java_com_example_NativeThreadRunner_runInNativeThread(JNIEnv *env, jobject thiz, jobject runnable) {
    // 获取JavaVM实例
    JavaVM *jvm;
    (*env)->GetJavaVM(env, &jvm);

    // 创建全局引用，防止Runnable被GC回收
    jobject globalRunnable = (*env)->NewGlobalRef(env, runnable);

    // 获取Runnable类的run方法ID
    jclass runnableClass = (*env)->GetObjectClass(env, runnable);
    jmethodID runMethod = (*env)->GetMethodID(env, runnableClass, "run", "()V");

    // 准备线程参数
    ThreadParams* params = malloc(sizeof(ThreadParams));
    params->jvm = jvm;
    params->runnable = globalRunnable;
    params->runMethod = runMethod;

    // 创建线程
    pthread_t thread;
    int result = pthread_create(&thread, NULL, thread_func, params);
    if (result != 0) {
        LOGD("Failed to create thread");
        (*env)->DeleteGlobalRef(env, globalRunnable);
        free(params);
    }

    // 可以选择pthread_join来等待线程结束，这里让线程自由运行
}