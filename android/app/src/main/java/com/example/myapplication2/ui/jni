#include <jni.h>
#include <pthread.h>
#include <android/log.h>
#include <android/native_window.h> // 如果需要使用唤醒锁

#define LOG_TAG "NativeThread"
#define LOGD(...) __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG, __VA_ARGS__)

// 线程参数结构体
typedef struct {
    JavaVM *jvm;
    jobject runnable;
    jmethodID runMethod;
} ThreadParams;

// 线程函数
void* thread_func(void* arg) {
    ThreadParams* params = (ThreadParams*)arg;
    JNIEnv* env;
    jint ret;

    // 附加当前线程到JVM
    ret = (*params->jvm)->AttachCurrentThread(params->jvm, &env, NULL);
    if (ret != JNI_OK) {
        LOGD("Failed to attach thread to JVM");
        return NULL;
    }

    // 获取唤醒锁 (Android特有)
    #ifdef __ANDROID__
    // 注意: 实际使用时需要正确的上下文和权限
    // 这里只是示例，实际实现需要更完整的唤醒锁处理
    LOGD("Acquiring wake lock");
    // 实际代码中需要使用PowerManager.WakeLock
    #endif

    // 调用Runnable的run方法
    (*env)->CallVoidMethod(env, params->runnable, params->runMethod);

    // 释放唤醒锁
    #ifdef __ANDROID__
    LOGD("Releasing wake lock");
    #endif

    // 清理
    (*env)->DeleteGlobalRef(env, params->runnable);
    free(params);

    // 从JVM分离
    (*params->jvm)->DetachCurrentThread(params->jvm);

    return NULL;
}
